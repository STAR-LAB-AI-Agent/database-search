{
  "_说明": "这是 nanobot 的配置示例（~/.nanobot/config.json）。实际文件由 nanobot/setup.py 生成，或运行 `nanobot onboard` 生成后按需调整。",
  "providers": {
    "deepseek": {
      "apiKey": "${DEEPSEEK_API_KEY}",
      "apiBase": "https://api.deepseek.com"
    }
  },
  "agents": {
    "defaults": {
      "model": "deepseek-v4-pro",
      "provider": "deepseek"
    }
  }
}
